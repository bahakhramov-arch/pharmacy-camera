# Скопируйте этот файл в secrets.env и впишите значения. secrets.env в git не попадает.
BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_БОТА
# несколько получателей через запятую: владелец, координатор
CHAT_ID=ВСТАВЬТЕ_CHAT_ID
NVR_PASSWORD=ВСТАВЬТЕ_ПАРОЛЬ_РЕГИСТРАТОРА

# Сайт отчётов: http://127.0.0.1:8080
# Необязательный пароль (логин: report). Пусто = без пароля.
REPORTS_PASSWORD=
REPORTS_HOST=0.0.0.0
REPORTS_PORT=8080

# --- Филиал (для «Достлика» можно не писать - так и стоит по умолчанию) ---
BRANCH=Достлик
NVR_IP=192.168.1.99
NVR_LOGIN=admin
STAFF_CHANNELS=5
VISITOR_CHANNELS=1
# Команды бота принимает только ОДИН компьютер; на остальных филиалах BOT_COMMANDS=0
BOT_COMMANDS=1

# Порог распознавания лиц: выше = меньше путает клиентов с сотрудниками, но реже узнаёт (0.32 по умолчанию)
# MATCH_THRESHOLD=0.36

# Чат сотрудников (группа): только «пришёл(ла)». Добавьте бота в группу, напишите там /id
# STAFF_CHAT_ID=-1001234567890

# Время итога дня в Telegram (по умолчанию 23:00; аптека до полуночи - 23:59)
# DAILY_SUMMARY_TIME=23:59

# Строже для сотрудников без фото с камеры (enroll.py), напр. 0.42; 0 = как все
# STRICT_THRESHOLD=0.42
